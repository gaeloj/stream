        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "slug", "sortOrder", "isActive", "createdAt", "updatedAt"]
    },
    "Movie": {
      "title": "Movie",
      "description": "Metadados públicos de filme no catálogo sem exposição direta de link privado do Drive.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "synopsis": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1500
