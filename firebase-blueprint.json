{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Autorização explícita de administrador da plataforma.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "grantedBy", "createdAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Perfil de usuário (assinante ou administrador) com estado de assinatura e saldo de teste gratuito.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["subscriber", "admin"]
        },
        "status": {
          "type": "string",
          "enum": ["trial", "active", "expired", "frozen", "blocked"]
        },
        "authProvider": {
          "type": "string",
          "enum": ["google", "password", "admin_provisioned"]
        },
        "planId": {
          "type": "string",
          "maxLength": 128
        },
        "planName": {
          "type": "string",
          "maxLength": 120
        },
        "trialSecondsRemaining": {
          "type": "integer"
        },
        "trialSecondsUsed": {
          "type": "integer"
        },
        "subscriptionStartedAt": {
          "type": "string",
          "format": "date-time"
        },
        "subscriptionExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "role",
        "status",
        "authProvider",
        "trialSecondsRemaining",
        "trialSecondsUsed",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Configurações globais da plataforma, incluindo duração padrão do teste gratuito e estado da configuração inicial.",
      "type": "object",
      "properties": {
        "platformName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "defaultTrialMinutes": {
          "type": "integer"
        },
        "allowSelfRegistration": {
          "type": "boolean"
        },
        "initializedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "initializedByEmail": {
          "type": "string",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "platformName",
        "defaultTrialMinutes",
        "allowSelfRegistration",
        "initializedByUid",
        "initializedByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "description": "Plano de assinatura configurável pelo administrador.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 4,
          "maxLength": 300
