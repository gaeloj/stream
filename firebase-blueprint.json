  "firestore": {
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Registros de privilégio administrativo verificados no servidor."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Contas de assinantes e administradores com isolamento estrito de PII."
    },
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/PlatformSettings"
      },
      "description": "Configurações globais da plataforma (documento 'platform')."
    },
    "/plans/{planId}": {
      "schema": {
        "$ref": "#/entities/SubscriptionPlan"
      },
      "description": "Planos de assinatura disponíveis e configurações de cobrança."
    },
    "/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "Categorias do catálogo."
    },
    "/movies/{movieId}": {
      "schema": {
        "$ref": "#/entities/Movie"
      },
      "description": "Catálogo de filmes."
    },
    "/series/{seriesId}": {
      "schema": {
        "$ref": "#/entities/Series"
      },
      "description": "Catálogo de séries."
    },
    "/seasons/{seasonId}": {
      "schema": {
        "$ref": "#/entities/Season"
      },
      "description": "Temporadas das séries."
    },
    "/episodes/{episodeId}": {
      "schema": {
        "$ref": "#/entities/Episode"
      },
      "description": "Episódios das temporadas."
    },
    "/mediaSources/{sourceId}": {
      "schema": {
        "$ref": "#/entities/MediaSource"
      },
      "description": "Cofre restrito a administradores com links e IDs privados do Google Drive/CDN."
    },
    "/watchHistory/{historyId}": {
      "schema": {
        "$ref": "#/entities/WatchHistory"
      },
      "description": "Histórico e posição de reprodução do usuário."
    },
    "/favorites/{favId}": {
      "schema": {
        "$ref": "#/entities/FavoriteItem"
      },
      "description": "Favoritos (Minha Lista) do assinante."
    },
    "/playbackSessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/PlaybackSession"
      },
      "description": "Sessões de reprodução rastreadas para controle de acesso."
    },
    "/adminLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/AdminAuditLog"
      },
      "description": "Trilha de auditoria imutável das ações administrativas."
    }
  }
}
